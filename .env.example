# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres ---
# Used by docker-compose.yml to create the container's superuser/db, and by
# the app (as part of DATABASE_URL) to connect to it.
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=taskflow_db

# Full connection string the app and migrations use. Must match the
# POSTGRES_* values above when pointing at the local docker-compose stack.
DATABASE_URL=postgres://taskflow_user:changeme@localhost:5432/taskflow_db

# Tests run against this DB, never DATABASE_URL (they delete rows). Name must
# end in _test. Create + migrate it with: npm run test:db:setup
TEST_DATABASE_URL=postgres://taskflow_user:changeme@localhost:5432/taskflow_test

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Docker Compose ---
# `docker compose up --build` builds DATABASE_URL/REDIS_URL for the containers
# from POSTGRES_* itself (host names `postgres`/`redis`); the DATABASE_URL and
# REDIS_URL above are for processes you run on the host (npm scripts, tests).
# Keep POSTGRES_PASSWORD alphanumeric so it is safe inside a URL.
# Host port the API is published on (loopback only):
API_PORT=3000

# --- API ---
PORT=3000
# Required on every mutating request as the `x-api-key` header.
# Generate one with: openssl rand -hex 32
API_KEY=changeme

# --- Worker ---
# Jobs one worker process runs at once.
WORKER_CONCURRENCY=4
# How long a claim attempt waits before polling again when no job is due.
POLL_INTERVAL_MS=500
# How long a claimed job's lease lasts before the reaper considers it
# abandoned. Must be well above HEARTBEAT_INTERVAL_MS.
LEASE_MS=30000
# How often a worker extends the lease of the job it's running. Default is
# LEASE_MS/3 if unset.
HEARTBEAT_INTERVAL_MS=10000
# How often a worker scans for PROCESSING jobs with an expired lease.
REAP_INTERVAL_MS=5000
# On SIGTERM/SIGINT, how long to let in-flight jobs finish before exiting
# anyway (their leases then expire normally and the reaper retries them).
SHUTDOWN_GRACE_MS=25000
# A worker is marked DEAD in the registry if it hasn't heartbeat within this
# long. Default is HEARTBEAT_INTERVAL_MS*3 if unset. Registry status only -
# does not affect job recovery, which depends solely on lease expiry.
DEAD_WORKER_THRESHOLD_MS=30000

# Reaper: a job whose lease expires this many times (worker crash loop) is
# quarantined to DEAD instead of being retried forever. Does NOT use up the
# job's handler-failure retry budget (max_attempts).
MAX_LEASE_RECOVERIES=10
# Postgres pool size per process.
PG_POOL_MAX=10
